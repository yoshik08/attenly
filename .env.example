# 32 random bytes, hex (64 chars) or base64. Used to encrypt the ERP session cookie.
# Generate one with: openssl rand -hex 32
# If unset, the server uses an ephemeral key (sessions won't survive restarts).
SESSION_SECRET=

# Base URL of the KL University ERP portal (Yii2 app).
ERP_BASE=https://newerp.kluniversity.in

# MongoDB connection string for attendance snapshots (expo demo).
# Local Docker: docker run -d -p 27017:27017 --name mongo mongo
# Or use a free MongoDB Atlas cluster. If unset, snapshots are skipped
# gracefully and the app still works with in-browser data.
MONGODB_URI=mongodb://localhost:27017/skipwise

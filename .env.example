# Google sign-in (NextAuth v4). NEXTAUTH_URL is the auth API on the canonical host:
#   production: https://yoshik.xyz/attenly/api/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000/attenly/api/auth

# MongoDB Atlas. Data lives in the `skipwise` database (users, snapshots, locks).
MONGODB_URI=

# 32 random bytes (64 hex chars or base64) for the short-lived captcha session
# token. It also opens ERP passwords that an older build stored sealed, so they
# can be converted to plain storage. Generate with: openssl rand -hex 32
SESSION_SECRET=

# The CRNN captcha solver (klu-captcha-solver on Render): POST /solve { image } -> { text }.
# Without it the link form asks people to type the captcha.
SOLVER_URL=

# Manual trigger for /api/cron/sync (GitHub Actions authenticates with OIDC instead).
CRON_SECRET=

# Optional: point the ERP client elsewhere (the tests use a local mock).
# ERP_BASE=https://newerp.kluniversity.in
